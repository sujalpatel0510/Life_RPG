# Database (PostgreSQL Connection URL)
# Local: postgresql://postgres:admin@localhost:5432/liferpg_db?schema=public
# Hosted (Supabase/Neon/Render): postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL="postgresql://postgres:admin@localhost:5432/liferpg_db?schema=public"

# Security / Authentication
JWT_SECRET="super_secure_jwt_secret_key_change_in_production_min_32_chars"

# Server Port & Environment
PORT=5000
NODE_ENV="development"

# Allowed Client Origin(s) for CORS (comma-separated or wildcard *)
CLIENT_URL="http://localhost:5173,https://your-frontend.vercel.app"
