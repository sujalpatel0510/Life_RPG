generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum HeroClass {
  WARRIOR
  MAGE
  ROGUE
  PALADIN
}

enum StatCategory {
  STRENGTH
  INTELLECT
  VITALITY
  WISDOM
  AGILITY
  CHARISMA
}

enum QuestDifficulty {
  TRIVIAL
  EASY
  MEDIUM
  HARD
  EPIC
}

enum QuestType {
  HABIT
  DAILY
  TODO
  STORY
}

enum ItemCategory {
  WEAPON
  ARMOR
  RELIC
  POTION
  BADGE
}

enum ItemRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  username     String        @unique
  passwordHash String
  character    Character?
  quests       Quest[]
  inventory    UserItem[]
  activityLogs ActivityLog[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Character {
  id             String    @id @default(uuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  heroClass      HeroClass @default(WARRIOR)
  title          String    @default("Novice Adventurer")
  level          Int       @default(1)
  currentXp      Int       @default(0)
  nextLevelXp    Int       @default(100)
  gold           Int       @default(50)
  gems           Int       @default(5)
  hp             Int       @default(100)
  maxHp          Int       @default(100)
  strength       Int       @default(10)
  intellect      Int       @default(10)
  vitality       Int       @default(10)
  wisdom         Int       @default(10)
  agility        Int       @default(10)
  charisma       Int       @default(10)
  streakDays     Int       @default(1)
  lastActiveDate DateTime? @default(now())
  avatarUrl      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Quest {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  category    StatCategory    @default(INTELLECT)
  difficulty  QuestDifficulty @default(MEDIUM)
  questType   QuestType       @default(TODO)
  xpReward    Int             @default(50)
  goldReward  Int             @default(20)
  gemReward   Int             @default(1)
  isCompleted Boolean         @default(false)
  completedAt DateTime?
  dueDate     DateTime?
  streakCount Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model ShopItem {
  id           String       @id @default(uuid())
  name         String       @unique
  description  String
  category     ItemCategory
  rarity       ItemRarity   @default(COMMON)
  priceGold    Int          @default(100)
  priceGems    Int          @default(0)
  statBonusStr Int          @default(0)
  statBonusInt Int          @default(0)
  statBonusVit Int          @default(0)
  statBonusWis Int          @default(0)
  statBonusAgi Int          @default(0)
  statBonusCha Int          @default(0)
  damageBonus  Int          @default(0)
  icon         String       @default("sword")
  userItems    UserItem[]
  createdAt    DateTime     @default(now())
}

model UserItem {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId     String
  item       ShopItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  isEquipped Boolean  @default(false)
  acquiredAt DateTime @default(now())

  @@unique([userId, itemId])
}

model Boss {
  id          String   @id @default(uuid())
  name        String
  title       String
  description String
  hp          Int
  maxHp       Int
  level       Int      @default(5)
  rewardGold  Int      @default(300)
  rewardXp    Int      @default(500)
  rewardBadge String   @default("Dragon Slayer")
  avatar      String   @default("dragon")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ActivityLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  actionType String
  details    String
  createdAt  DateTime @default(now())
}
